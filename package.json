{
  "name": "@dafengzhen/event-bus",
  "version": "0.1.20",
  "description": "A lightweight TypeScript event bus with strong typing, middleware pipeline, and pattern-based event listeners.",
  "keywords": [
    "event-bus",
    "event-emitter",
    "events",
    "middleware",
    "observer",
    "pattern-matching",
    "pubsub",
    "typed",
    "typescript"
  ],
  "homepage": "https://github.com/dafengzhen/event-bus#readme",
  "bugs": {
    "url": "https://github.com/dafengzhen/event-bus/issues"
  },
  "license": "MIT",
  "author": "dafengzhen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dafengzhen/event-bus.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/cjs/modern/index.js",
  "module": "./dist/esm/modern/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/modern/index.js",
      "require": "./dist/cjs/modern/index.js",
      "default": "./dist/esm/modern/index.js"
    }
  },
  "scripts": {
    "build:types": "tsc -p tsconfig.types.json",
    "build:modern": "parcel build src/index.ts --target modern-esm --target modern-cjs",
    "build:legacy": "parcel build src/index.ts --target legacy-esm --target legacy-cjs",
    "build:dev": "parcel build src/index.ts --target modern-esm-dev --target modern-cjs-dev --target legacy-esm-dev --target legacy-cjs-dev",
    "build": "npm run build:types && npm run build:modern && npm run build:legacy && npm run build:dev",
    "prepare": "husky install",
    "test": "jest",
    "watch": "parcel watch",
    "fmt": "oxfmt",
    "lint": "oxlint --fix",
    "lint:fmt": "run-s lint fmt"
  },
  "dependencies": {
    "@dafengzhen/derivative-matcher": "^0.1.1",
    "@swc/helpers": "^0.5.23",
    "browserslist-config-baseline": "^0.5.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/prompt-cli": "^21.2.0",
    "@jest/globals": "^30.4.1",
    "@parcel/packager-ts": "^2.16.4",
    "@parcel/transformer-typescript-types": "^2.16.4",
    "@types/node": "^26.1.2",
    "babel-jest": "^30.4.1",
    "eslint-plugin-perfectionist": "^5.10.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "parcel": "^2.16.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "npm run lint",
    "*": "npm run fmt --no-error-on-unmatched-pattern"
  },
  "allowScripts": {
    "lmdb@2.8.5": true,
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.15.47": true,
    "unrs-resolver@1.12.2": true,
    "msgpackr-extract@3.0.4": true
  },
  "targets": {
    "legacy-cjs": {
      "distDir": "./dist/cjs/legacy",
      "engines": {
        "browsers": ">0.3%, Chrome >= 87, ChromeAndroid >= 87, Edge >= 87, Firefox >= 83, FirefoxAndroid >= 83, Safari >= 14, iOS >= 14"
      },
      "includeNodeModules": true,
      "isLibrary": true,
      "optimize": true,
      "outputFormat": "commonjs",
      "sourceMap": true
    },
    "legacy-cjs-dev": {
      "distDir": "./dist/cjs/legacy-dev",
      "engines": {
        "browsers": ">0.3%, Chrome >= 87, ChromeAndroid >= 87, Edge >= 87, Firefox >= 83, FirefoxAndroid >= 83, Safari >= 14, iOS >= 14"
      },
      "includeNodeModules": true,
      "isLibrary": true,
      "optimize": false,
      "outputFormat": "commonjs",
      "sourceMap": true
    },
    "legacy-esm": {
      "distDir": "./dist/esm/legacy",
      "engines": {
        "browsers": ">0.3%, Chrome >= 87, ChromeAndroid >= 87, Edge >= 87, Firefox >= 83, FirefoxAndroid >= 83, Safari >= 14, iOS >= 14"
      },
      "includeNodeModules": true,
      "isLibrary": true,
      "optimize": true,
      "outputFormat": "esmodule",
      "sourceMap": true
    },
    "legacy-esm-dev": {
      "distDir": "./dist/esm/legacy-dev",
      "engines": {
        "browsers": ">0.3%, Chrome >= 87, ChromeAndroid >= 87, Edge >= 87, Firefox >= 83, FirefoxAndroid >= 83, Safari >= 14, iOS >= 14"
      },
      "includeNodeModules": true,
      "isLibrary": true,
      "optimize": false,
      "outputFormat": "esmodule",
      "sourceMap": true
    },
    "modern-cjs": {
      "distDir": "./dist/cjs/modern",
      "includeNodeModules": true,
      "isLibrary": true,
      "optimize": true,
      "outputFormat": "commonjs",
      "sourceMap": true
    },
    "modern-cjs-dev": {
      "distDir": "./dist/cjs/modern-dev",
      "includeNodeModules": true,
      "isLibrary": true,
      "optimize": false,
      "outputFormat": "commonjs",
      "sourceMap": true
    },
    "modern-esm": {
      "distDir": "./dist/esm/modern",
      "includeNodeModules": true,
      "isLibrary": true,
      "optimize": true,
      "outputFormat": "esmodule",
      "sourceMap": true
    },
    "modern-esm-dev": {
      "distDir": "./dist/esm/modern-dev",
      "includeNodeModules": true,
      "isLibrary": true,
      "optimize": false,
      "outputFormat": "esmodule",
      "sourceMap": true
    }
  }
}
