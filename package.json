{
  "name": "@dafengzhen/event-bus",
  "version": "0.1.1",
  "description": "A lightweight TypeScript event bus with strong typing, middleware pipeline, and pattern-based event listeners.",
  "keywords": [
    "event-bus",
    "event-emitter",
    "events",
    "middleware",
    "observer",
    "pattern-matching",
    "pubsub",
    "typed",
    "typescript"
  ],
  "homepage": "https://github.com/dafengzhen/event-bus#readme",
  "bugs": {
    "url": "https://github.com/dafengzhen/event-bus/issues"
  },
  "license": "MIT",
  "author": "dafengzhen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dafengzhen/event-bus.git"
  },
  "source": "./src/index.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "default": "./dist/esm/modern/index.js"
      },
      "require": {
        "default": "./dist/cjs/modern/index.js"
      }
    }
  },
  "scripts": {
    "build": "parcel build",
    "prepare": "husky install",
    "test": "jest",
    "watch": "parcel watch",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:fmt": "npm run lint:fix && npm run fmt"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.18",
    "browserslist-config-baseline": "^0.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-typescript": "^7.28.5",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@commitlint/prompt-cli": "^20.3.1",
    "@jest/globals": "^30.2.0",
    "@parcel/packager-ts": "^2.16.3",
    "@parcel/transformer-typescript-types": "^2.16.3",
    "@types/node": "^25.0.10",
    "babel-jest": "^30.2.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "parcel": "^2.16.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "npm run lint",
    "*": "npm run fmt --no-error-on-unmatched-pattern"
  },
  "targets": {
    "legacy-cjs": {
      "distDir": "./dist/cjs/legacy",
      "engines": {
        "browsers": ">0.3%, Chrome >= 87, ChromeAndroid >= 87, Edge >= 87, Firefox >= 83, FirefoxAndroid >= 83, Safari >= 14, iOS >= 14"
      },
      "includeNodeModules": true,
      "isLibrary": true,
      "optimize": true,
      "outputFormat": "commonjs",
      "sourceMap": true
    },
    "legacy-cjs-dev": {
      "distDir": "./dist/cjs/legacy-dev",
      "engines": {
        "browsers": ">0.3%, Chrome >= 87, ChromeAndroid >= 87, Edge >= 87, Firefox >= 83, FirefoxAndroid >= 83, Safari >= 14, iOS >= 14"
      },
      "includeNodeModules": true,
      "isLibrary": true,
      "optimize": false,
      "outputFormat": "commonjs",
      "sourceMap": true
    },
    "legacy-esm": {
      "distDir": "./dist/esm/legacy",
      "engines": {
        "browsers": ">0.3%, Chrome >= 87, ChromeAndroid >= 87, Edge >= 87, Firefox >= 83, FirefoxAndroid >= 83, Safari >= 14, iOS >= 14"
      },
      "includeNodeModules": true,
      "isLibrary": true,
      "optimize": true,
      "outputFormat": "esmodule",
      "sourceMap": true
    },
    "legacy-esm-dev": {
      "distDir": "./dist/esm/legacy-dev",
      "engines": {
        "browsers": ">0.3%, Chrome >= 87, ChromeAndroid >= 87, Edge >= 87, Firefox >= 83, FirefoxAndroid >= 83, Safari >= 14, iOS >= 14"
      },
      "includeNodeModules": true,
      "isLibrary": true,
      "optimize": false,
      "outputFormat": "esmodule",
      "sourceMap": true
    },
    "modern-cjs": {
      "distDir": "./dist/cjs/modern",
      "includeNodeModules": true,
      "isLibrary": true,
      "optimize": true,
      "outputFormat": "commonjs",
      "sourceMap": true
    },
    "modern-cjs-dev": {
      "distDir": "./dist/cjs/modern-dev",
      "includeNodeModules": true,
      "isLibrary": true,
      "optimize": false,
      "outputFormat": "commonjs",
      "sourceMap": true
    },
    "modern-esm": {
      "distDir": "./dist/esm/modern",
      "includeNodeModules": true,
      "isLibrary": true,
      "optimize": true,
      "outputFormat": "esmodule",
      "sourceMap": true
    },
    "modern-esm-dev": {
      "distDir": "./dist/esm/modern-dev",
      "includeNodeModules": true,
      "isLibrary": true,
      "optimize": false,
      "outputFormat": "esmodule",
      "sourceMap": true
    }
  }
}
